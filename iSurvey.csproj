<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEVRELOAD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Ba bản trong một bundle: net48 = 2022–2024, net8 = 2025–2026, net10 = 2027. -->
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>iSurvey</RootNamespace>
    <AssemblyName>iSurvey</AssemblyName>
    <!-- Nguồn phiên bản duy nhất cho code (AuthManager.AppVersion); bump cùng PackageContents.xml. -->
    <Version>1.8.6</Version>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ProjNet" Version="2.0.0" />
    <!-- GDAL 3.13 (win-x64) cho nhập MapInfo TAB. Gói "MaxRev.Gdal.Windows" không còn trên NuGet. -->
    <PackageReference Include="MaxRev.Gdal.Core" Version="3.13.3.583" />
    <PackageReference Include="MaxRev.Gdal.WindowsRuntime.Minimal" Version="3.13.3.583" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="PolySharp" Version="1.15.0" Condition="'$(TargetFramework)' == 'net48'" PrivateAssets="all" />
    <!-- ExcludeAssets=runtime: API chỉ để biên dịch, AutoCAD cung cấp DLL lúc chạy. -->
    <!-- 24.1 = API 2022. AutoCAD 2023 và 2024 nạp được plugin build từ SDK 2022; chiều ngược lại thì không. -->
    <PackageReference Include="AutoCAD.NET" Version="24.1.51000" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" Condition="'$(TargetFramework)' == 'net8.0-windows'" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" Condition="'$(TargetFramework)' == 'net10.0-windows'" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <!-- Tool/smoke test riêng; không biên dịch vào add-in (kể cả obj lồng nhau). -->
  <ItemGroup>
    <Compile Remove="deploy\tools\**" />
    <None Remove="deploy\tools\**" />
    <EmbeddedResource Remove="deploy\tools\**" />
    <Page Remove="deploy\tools\**" />
  </ItemGroup>
  <ItemGroup>
    <None Update="src\Data\isurvey_vn2000_tm3.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Data\isurvey_vn2000_tm3.json</Link></None>
    <None Update="src\Data\isurvey_map_sources.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Data\isurvey_map_sources.json</Link></None>
    <None Update="src\Data\isurvey_province_crs_map.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Data\isurvey_province_crs_map.json</Link></None>
    <None Update="src\Data\dgn_layer_mapping.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Data\dgn_layer_mapping.json</Link></None>
    <!-- Seed DGN (C2D): VN2000_Seed2D_V8.dgn / VN2000_Seed2D_V7.dgn; build-bundle.ps1 copy vao Contents\Seeds. -->
    <None Include="src\Seeds\*.dgn"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Seeds\%(Filename)%(Extension)</Link></None>
    <!-- Khung ban do chuan (ISURVEY_KHUNG): build-bundle.ps1 copy vao Contents\Templates. -->
    <None Include="src\Templates\*.dwg"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Templates\%(Filename)%(Extension)</Link></None>
    <EmbeddedResource Include="deploy\Apply-iSurveyUpdate.ps1" LogicalName="iSurvey.Apply-iSurveyUpdate.ps1" />
  </ItemGroup>
</Project>
