<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEVRELOAD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Ba bản trong một bundle: net48 = 2023–2024, net8 = 2025–2026, net10 = 2027. -->
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>iSurvey</RootNamespace>
    <AssemblyName>iSurvey</AssemblyName>
    <!-- Nguồn phiên bản duy nhất cho code (AuthManager.AppVersion); bump cùng PackageContents.xml. -->
    <Version>1.5.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ProjNet" Version="2.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="PolySharp" Version="1.15.0" Condition="'$(TargetFramework)' == 'net48'" PrivateAssets="all" />
    <!-- ExcludeAssets=runtime: API chỉ để biên dịch, AutoCAD cung cấp DLL lúc chạy. -->
    <PackageReference Include="AutoCAD.NET" Version="24.2.0" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" Condition="'$(TargetFramework)' == 'net8.0-windows'" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" Condition="'$(TargetFramework)' == 'net10.0-windows'" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <None Update="src\Data\isurvey_vn2000_tm3.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Data\isurvey_vn2000_tm3.json</Link></None>
    <None Update="src\Data\isurvey_map_sources.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Data\isurvey_map_sources.json</Link></None>
    <None Update="src\Data\isurvey_province_crs_map.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Data\isurvey_province_crs_map.json</Link></None>
  </ItemGroup>
</Project>
