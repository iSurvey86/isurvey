<Window x:Class="iSurvey.UI.Account.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
        </Border.Effect>
        <StackPanel>
            <Border Height="46" CornerRadius="12,12,0,0" Background="#1D4ED8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource CtaClose}" Click="Secondary_Click"/>
                </Grid>
            </Border>

            <StackPanel Margin="24,18,24,20">
                <TextBlock x:Name="HeadlineText" Foreground="#111827" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Grid x:Name="RowsGrid" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="MessageText" Foreground="#374151" FontSize="13" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="NoteText" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="SecondaryButton" Content="Hủy" MinWidth="96" Height="36" Margin="0,0,10,0"
                            Style="{StaticResource CtaSoft}" Click="Secondary_Click" Visibility="Collapsed"/>
                    <Button x:Name="PrimaryButton" Content="Đóng" MinWidth="110" Height="36" IsDefault="True"
                            Style="{StaticResource CtaPrimary}" Click="Primary_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
