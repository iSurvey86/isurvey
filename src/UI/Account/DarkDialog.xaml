<Window x:Class="iSurvey.UI.Account.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15" Width="30" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#2B303B" BorderBrush="#4A5366" BorderThickness="1" CornerRadius="10" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <Border Height="46" CornerRadius="9,9,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#0284C7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="18,0,10,0">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource CloseButton}" Click="Secondary_Click"/>
                </Grid>
            </Border>

            <StackPanel Margin="24,18,24,20">
                <TextBlock x:Name="HeadlineText" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Grid x:Name="RowsGrid" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="MessageText" Foreground="#D5DBE6" FontSize="13" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="NoteText" Foreground="#8C96A8" FontSize="11.5" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="SecondaryButton" Content="Hủy" Width="96" Height="36" Margin="0,0,10,0"
                            Background="#1D4ED8" Style="{StaticResource ActionButton}" Click="Secondary_Click"
                            Visibility="Collapsed"/>
                    <Button x:Name="PrimaryButton" Content="Đóng" Width="110" Height="36" IsDefault="True"
                            Background="#0284C7" Style="{StaticResource ActionButton}" Click="Primary_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
