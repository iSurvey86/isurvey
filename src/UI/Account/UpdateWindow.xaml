<Window x:Class="iSurvey.UI.Account.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật iSurvey"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Width="30" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#2B303B" BorderBrush="#4A5366" BorderThickness="1" CornerRadius="10" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <Border Height="46" CornerRadius="9,9,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#0284C7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="18,0,10,0">
                    <TextBlock Text="CẬP NHẬT iSurvey" Foreground="White" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseX" Content="✕" FontSize="14" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Style="{StaticResource CloseButton}" Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Margin="24,18,24,20">
                <!-- Chế độ: có bản mới -->
                <StackPanel x:Name="OfferPanel">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phiên bản hiện tại" Foreground="#8C96A8" FontSize="11.5"/>
                            <TextBlock x:Name="CurrentText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" Foreground="#8C96A8" FontSize="18"
                                   VerticalAlignment="Center" Margin="12,8"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phiên bản mới" Foreground="#8C96A8" FontSize="11.5"/>
                            <TextBlock x:Name="LatestText" Foreground="#4ADE80" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="NotesTitle" Text="Tính năng mới:" Foreground="White" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <StackPanel x:Name="NotesList"/>
                    <TextBlock x:Name="DetailLink" Text="Chi tiết" Foreground="#38ABFF" FontSize="12.5"
                               Cursor="Hand" Margin="0,4,0,0" Visibility="Collapsed"
                               MouseLeftButtonUp="Detail_Click"/>

                    <TextBlock x:Name="MessageText" Foreground="#D5DBE6" FontSize="13" TextWrapping="Wrap"
                               Margin="0,16,0,0"
                               Text="Đã có bản cập nhật mới. Bấm Cập nhật ngay để cài bản mới."/>
                    <TextBlock x:Name="ForceText" Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="CloseButton" Content="Đóng" Width="110" Height="36" Margin="0,0,10,0"
                                Background="#4A5366" Style="{StaticResource ActionButton}" Click="Close_Click"/>
                        <Button x:Name="UpdateButton" Content="Cập nhật ngay" Width="140" Height="36"
                                Background="#0284C7" Style="{StaticResource ActionButton}" Click="Update_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Chế độ: đang tải / lỗi -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressTitle" Text="Đang tải gói cài đặt..." Foreground="White"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProgressStatus" Foreground="#8C96A8" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <ProgressBar x:Name="Bar" Height="10" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                 Foreground="#0284C7" Background="#1E222A"/>
                    <TextBlock x:Name="PercentText" Foreground="#8C96A8" FontSize="12" HorizontalAlignment="Right"
                               Margin="0,6,0,0"/>
                    <StackPanel x:Name="ProgressButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,18,0,0" Visibility="Collapsed">
                        <Button x:Name="ErrorClose" Content="Đóng" Width="110" Height="36"
                                Background="#4A5366" Style="{StaticResource ActionButton}" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
