<Window x:Class="iSurvey.UI.Account.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật iSurvey"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#243040"/>
        <SolidColorBrush x:Key="Muted" Color="#5C6B7A"/>
        <SolidColorBrush x:Key="Accent" Color="#1F6FD1"/>
        <SolidColorBrush x:Key="CardEdge" Color="#D5DBE4"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A82EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#185AAD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A9B6C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="BorderBrush" Value="#C5CED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F7FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E7EDF5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Border Background="White" BorderBrush="{StaticResource CardEdge}" BorderThickness="1"
                CornerRadius="4" Padding="18,16,18,14">
            <StackPanel>
                <StackPanel x:Name="OfferPanel">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,16">
                        <StackPanel Width="168">
                            <TextBlock Text="Phiên bản hiện tại" Foreground="{StaticResource Muted}" FontSize="12"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentText" Foreground="{StaticResource Ink}" FontSize="20"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="→" Foreground="#8A97A6" FontSize="18" VerticalAlignment="Center"
                                   Margin="8,10,8,0"/>
                        <StackPanel Width="168">
                            <TextBlock Text="Phiên bản mới" Foreground="{StaticResource Muted}" FontSize="12"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LatestText" Foreground="#1B7A3A" FontSize="20"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="NotesTitle" Text="Tính năng mới:" Foreground="#1F4E8C" FontSize="13"
                               FontWeight="Bold" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel x:Name="NotesList"/>
                    <TextBlock x:Name="DetailLink" Text="Chi tiết" Foreground="{StaticResource Accent}" FontSize="12.5"
                               Cursor="Hand" Margin="0,6,0,0" Visibility="Collapsed"
                               MouseLeftButtonUp="Detail_Click"/>

                    <TextBlock x:Name="MessageText" Foreground="{StaticResource Ink}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,14,0,0"
                               Text="Đã có bản cập nhật mới. Bấm Cập nhật ngay để cài bản mới."/>
                    <TextBlock x:Name="ForceText" Foreground="#9A6700" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressTitle" Text="Đang tải gói cài đặt..." Foreground="{StaticResource Ink}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProgressStatus" Foreground="{StaticResource Muted}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <ProgressBar x:Name="Bar" Height="8" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource Accent}" Background="#E6EBF1" BorderThickness="0"/>
                    <TextBlock x:Name="PercentText" Foreground="{StaticResource Muted}" FontSize="12"
                               HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Content="Đóng" Style="{StaticResource QuietButton}" Margin="0,0,10,0"
                    Click="Close_Click" IsCancel="True"/>
            <Button x:Name="UpdateButton" Content="Cập nhật ngay" Style="{StaticResource PrimaryButton}"
                    Click="Update_Click"/>
            <Button x:Name="ErrorClose" Content="Đóng" Style="{StaticResource QuietButton}"
                    Click="Close_Click" Visibility="Collapsed"/>
        </StackPanel>
    </StackPanel>
</Window>
