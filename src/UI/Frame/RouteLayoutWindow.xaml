<Window x:Class="iSurvey.UI.Frame.RouteLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Dàn trang in"
        Width="1000" Height="740" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F6FD1" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1F4E8C" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A82EA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A9B6C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E1E5EB" />
            <Setter Property="VerticalGridLinesBrush" Value="#E1E5EB" />
            <Setter Property="BorderBrush" Value="#C9D1DC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="RowHeight" Value="26" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Cài đặt bố cục & bản in -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D5DBE4" BorderThickness="1" CornerRadius="4" Padding="14,10,14,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="1. CÀI ĐẶT BỐ CỤC &amp; BẢN IN" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Khổ giấy" FontWeight="SemiBold" Foreground="#1F4E8C" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Khổ:" Width="72" />
                            <ComboBox x:Name="SizeBox" Width="160" SelectionChanged="Plan_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Tỷ lệ:" Width="72" />
                            <ComboBox x:Name="ScaleBox" Width="110" SelectionChanged="Plan_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lbl}" Text="Chồng gối (m):" Width="92" />
                            <TextBox x:Name="OverlapBox" Width="70" TextChanged="Overlap_TextChanged" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Lưới layout" FontWeight="SemiBold" Foreground="#1F4E8C" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Hàng:" Width="72" />
                            <TextBox x:Name="RowsBox" Width="56" TextChanged="Grid_TextChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Cột:" Width="72" />
                            <TextBox x:Name="ColsBox" Width="56" TextChanged="Grid_TextChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lbl}" Text="Cách (mm):" Width="72" />
                            <TextBox x:Name="GapBox" Width="56" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="InfoText" Margin="0,10,0,0" Foreground="#1F4E8C" TextWrapping="Wrap" />
                <TextBlock x:Name="WarnText" Margin="0,2,0,0" Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- 2. Thông tin khung tên -->
        <Border Grid.Row="1" Margin="0,12,0,12" Background="White" BorderBrush="#D5DBE4" BorderThickness="1" CornerRadius="4" Padding="14,10,14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Nhập TXT/CSV" Padding="12,4" Click="Import_Click"
                            ToolTip="Mỗi dòng: MÃ;nội dung hoặc STT;nội dung. Ô Tờ và tỷ lệ vẫn tự điền." />
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"
                               Text="2. THÔNG TIN KHUNG TÊN (áp dụng cho mọi tờ)" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="LeftGrid" Grid.Column="0" Style="{StaticResource FieldGrid}"
                              SelectionChanged="Grid_SelectionChanged" BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding" PreviewMouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt, Mode=OneWay}" IsReadOnly="True" Width="44" />
                            <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="130" />
                            <DataGridTextColumn Header="Nội dung (kích đúp để sửa)" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="RightGrid" Grid.Column="2" Style="{StaticResource FieldGrid}"
                              SelectionChanged="Grid_SelectionChanged" BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding" PreviewMouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt, Mode=OneWay}" IsReadOnly="True" Width="44" />
                            <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="130" />
                            <DataGridTextColumn Header="Nội dung (kích đúp để sửa)" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ContentLabel" Grid.Column="0" Style="{StaticResource Lbl}" Text="Nội dung:" FontWeight="SemiBold" />
                    <TextBox x:Name="ContentBox" Grid.Column="1" MinHeight="28" TextChanged="Content_TextChanged" LostFocus="Content_LostFocus" />
                    <StackPanel x:Name="SignPanel" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                        <Button Content="Chèn chữ ký" Padding="14,4" Click="Sign_Click"
                                ToolTip="Chọn file DWG chữ ký. Đặt vào đúng ô họ tên này trên mọi tờ khi bấm Tạo Layout." />
                        <Button x:Name="SignClearButton" Content="✕" Padding="8,4" Margin="4,0,0,0" Click="SignClear_Click"
                                ToolTip="Bỏ chữ ký đã chọn cho ô này" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="LogoPanel" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                        <Button x:Name="LogoButton" Content="Thay Logo..." Padding="14,4" Click="Logo_Click"
                                ToolTip="Chọn ảnh logo thay cho logo EVN trong khung tên (áp dụng cho cả bản vẽ khi bấm Tạo Layout)" />
                        <Button x:Name="HideButton" Content="Ẩn logo" Padding="14,4" Margin="6,0,0,0" Click="HideLogo_Click"
                                ToolTip="Ẩn hoặc hiện logo này (tắt layer logo trong khung tên, áp dụng cho cả bản vẽ)" />
                        <Button x:Name="LogoClearButton" Content="✕" Padding="8,4" Margin="4,0,0,0" Click="LogoClear_Click"
                                ToolTip="Bỏ logo đã chọn (giữ nguyên logo hiện có)" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Chân hộp thoại -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <CheckBox x:Name="PdfCheck" Content="Tự động in PDF gộp sau khi tạo" />
                <TextBlock x:Name="LogoNote" Margin="0,4,0,0" Foreground="#555" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Hủy bỏ" Padding="22,7" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="Tạo Layout" Style="{StaticResource PrimaryButton}" IsDefault="False" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>


