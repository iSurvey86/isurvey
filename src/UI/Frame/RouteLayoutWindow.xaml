<Window x:Class="iSurvey.UI.Frame.RouteLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Rải khung theo tuyến"
        Width="980" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F6FD1" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1F4E8C" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A82EA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A9B6C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E1E5EB" />
            <Setter Property="VerticalGridLinesBrush" Value="#E1E5EB" />
            <Setter Property="BorderBrush" Value="#C9D1DC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="EnableRowVirtualization" Value="False" />
            <Setter Property="EnableColumnVirtualization" Value="False" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SttCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Value}" />
            <EventSetter Event="ToolTipOpening" Handler="Value_ToolTipOpening" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FDF5E6" />
                                <Setter Property="Foreground" Value="#1A1A1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="268" />
            <ColumnDefinition x:Name="GapColumn" Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. Bố cục in -->
        <Border x:Name="LayoutPanel" Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#D5DBE4" BorderThickness="1" CornerRadius="4" Padding="10,12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="1. BỐ CỤC IN" />
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="WarnText" Margin="0,0,0,8" Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed" />
                    <CheckBox x:Name="PdfCheck" Content="Tự động in PDF gộp sau khi tạo" Foreground="#16a34a" FontWeight="SemiBold"
                              Background="Transparent" IsChecked="True" />
                </StackPanel>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="Khổ giấy:" />
                        <ComboBox x:Name="SizeBox" Grid.Column="1" SelectionChanged="Plan_Changed" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="Tỷ lệ:" />
                        <ComboBox x:Name="ScaleBox" Grid.Column="1" SelectionChanged="Plan_Changed" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="Kiểu in:" />
                        <ComboBox x:Name="StyleBox" Grid.Column="1" ToolTip="In màu gắn acad.ctb. In đen trắng gắn monochrome.ctb. Độ dày nét lấy theo file trên máy.">
                            <ComboBoxItem Content="In màu" />
                            <ComboBoxItem Content="In đen trắng" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="Chồng gối (m):" />
                        <TextBox x:Name="OverlapBox" Grid.Column="1" HorizontalContentAlignment="Right" TextChanged="Overlap_TextChanged" />
                    </Grid>
                    <TextBlock Text="LƯỚI LAYOUT TRONG MODEL" FontWeight="SemiBold" Foreground="#1F4E8C" FontSize="12" Margin="0,12,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lbl}" Text="Hàng:" />
                            <TextBox x:Name="RowsBox" HorizontalContentAlignment="Right" TextChanged="Grid_TextChanged" />
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lbl}" Text="Cột:" />
                            <TextBox x:Name="ColsBox" HorizontalContentAlignment="Right" TextChanged="Grid_TextChanged" />
                        </DockPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="Khoảng cách (mm):" />
                        <TextBox x:Name="GapBox" Grid.Column="1" HorizontalContentAlignment="Right" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Thông tin khung tên -->
        <Border Grid.Row="0" Grid.Column="2" Background="White" BorderBrush="#D5DBE4" BorderThickness="1" CornerRadius="4" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Tải file mẫu" Padding="12,4" Margin="0,0,8,0" Click="Sample_Click"
                                ToolTip="Lưu file Excel mẫu. Ba cột: STT, Tiêu đề, Nội dung." />
                        <Button Content="Nhập Excel" Padding="12,4" Click="Import_Click"
                                ToolTip="Đọc cột STT và cột Nội dung từ Excel. Ô Tờ vẫn tự điền." />
                    </StackPanel>
                    <TextBlock x:Name="FieldsTitle" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"
                               Text="2. THÔNG TIN KHUNG TÊN" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="LeftGrid" Grid.Column="0" Style="{StaticResource FieldGrid}" CellStyle="{StaticResource FieldCell}" VerticalAlignment="Top"
                              SelectionChanged="Grid_SelectionChanged" BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding" PreviewMouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt, Mode=OneWay}" IsReadOnly="True" Width="40" ElementStyle="{StaticResource SttCell}" />
                            <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="116" />
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource ValueCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="RightGrid" Grid.Column="2" Style="{StaticResource FieldGrid}" CellStyle="{StaticResource FieldCell}" VerticalAlignment="Top"
                              SelectionChanged="Grid_SelectionChanged" BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding" PreviewMouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt, Mode=OneWay}" IsReadOnly="True" Width="40" ElementStyle="{StaticResource SttCell}" />
                            <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="116" />
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource ValueCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ContentLabel" Grid.Column="0" Style="{StaticResource Lbl}" Text="Sửa đổi:" FontWeight="SemiBold" Foreground="#1F4E8C" />
                    <TextBox x:Name="ContentBox" Grid.Column="1" MinHeight="28" TextChanged="Content_TextChanged" LostFocus="Content_LostFocus" />
                    <StackPanel x:Name="SignPanel" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed">
                        <Button x:Name="SignButton" Content="Chèn chữ ký" MinWidth="108" Padding="10,4" Click="Sign_Click"
                                ToolTip="Chọn file DWG chữ ký cho ô họ tên này." />
                    </StackPanel>
                    <StackPanel x:Name="LogoPanel" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed">
                        <Button x:Name="LogoButton" Content="Thay Logo..." Padding="10,4" Click="Logo_Click"
                                ToolTip="Chọn ảnh logo thay cho logo EVN trong khung tên (áp dụng cho cả bản vẽ khi bấm Tạo Layout)" />
                        <Button x:Name="HideButton" Content="Ẩn logo" Padding="10,4" Margin="6,0,0,0" Click="HideLogo_Click"
                                ToolTip="Ẩn hoặc hiện logo này (tắt layer logo trong khung tên, áp dụng cho cả bản vẽ)" />
                        <Button x:Name="LogoClearButton" Content="✕" Padding="8,4" Margin="4,0,0,0" Click="LogoClear_Click"
                                ToolTip="Bỏ logo đã chọn (giữ nguyên logo hiện có)" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <CheckBox x:Name="ApplyAllCheck" Content="Áp dụng cho toàn bộ khung" IsChecked="True" Visibility="Collapsed"
                          ToolTip="Bỏ chọn để chỉ sửa khung vừa nhắp. Ô Tờ và tỷ lệ giữ nguyên." />
                <TextBlock x:Name="LogoNote" Foreground="#555" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Hủy bỏ" Padding="22,7" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="▷  Tạo Layout" Style="{StaticResource PrimaryButton}" IsDefault="False" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>


