<Window x:Class="iSurvey.UI.Tuyen.CreateStationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Phát sinh cọc"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,10">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Cancel_Click" ToolTip="Đóng"/>
                    <TextBlock Text="iSurvey — Phát sinh cọc" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="16,14,16,8">
                <!-- Chỉ một dòng text: không viền, không nền, không icon -->
                <TextBlock Margin="0,0,0,14" TextWrapping="Wrap" FontSize="13">
                    <Run Text="Tên tuyến: " Foreground="#374151"/>
                    <Run x:Name="RouteNameRun" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                </TextBlock>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Từ lý trình (m)" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="FromBox" Padding="8,6"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="—" Foreground="#94A3B8"
                               VerticalAlignment="Bottom" Margin="8,0,8,8"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Đến lý trình (m)" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="ToBox" Padding="8,6"/>
                    </StackPanel>
                </Grid>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Bước cọc (m):" Foreground="#374151"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="StepBox" DockPanel.Dock="Left" Width="88" Padding="8,6" Text="20"/>
                </DockPanel>
            </StackPanel>
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Hủy bỏ" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"
                                Style="{StaticResource CtaSoft}"/>
                        <Button Content="Phát sinh cọc" MinWidth="120" Click="Create_Click"
                                Style="{StaticResource CtaPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
