<Window x:Class="iSurvey.UI.Tuyen.StationListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Danh sách cọc"
        Width="720" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,10">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Close_Click" ToolTip="Đóng"/>
                    <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <DataGrid x:Name="Grid" Grid.Row="1" Margin="12,10,12,0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#E2E8F0" BorderThickness="1"
                      RowHeight="28" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Km" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="Lý trình (m)" Binding="{Binding ChainageText}" Width="100"/>
                    <DataGridTextColumn Header="X" Binding="{Binding XText}" Width="*"/>
                    <DataGridTextColumn Header="Y" Binding="{Binding YText}" Width="*"/>
                    <DataGridTextColumn Header="Z" Binding="{Binding ZText}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="12,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Zoom" MinWidth="72" Margin="0,0,8,0" Click="Zoom_Click"
                                Style="{StaticResource CtaSoft}"/>
                        <Button Content="Xóa cọc" MinWidth="88" Margin="0,0,8,0" Click="Delete_Click"
                                Style="{StaticResource CtaSoft}"/>
                        <Button Content="Thêm cọc..." MinWidth="100" Click="Add_Click"
                                Style="{StaticResource CtaSoft}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Đóng" MinWidth="88" HorizontalAlignment="Right"
                            Click="Close_Click" Style="{StaticResource CtaPrimary}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
