<UserControl x:Class="iSurvey.UI.Palette.SurveyPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:iSurvey.UI.Palette"
             Background="#E7EBF0"
             FontFamily="Segoe UI"
             FontSize="13"
             Foreground="#1E293B">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <ContextMenu x:Key="NodeMenu" x:Shared="False"
                         ItemsSource="{Binding PlacementTarget.DataContext.Actions, RelativeSource={RelativeSource Self}}">
                <ContextMenu.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Title}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                    </Style>
                </ContextMenu.ItemContainerStyle>
            </ContextMenu>
            <Style x:Key="NodeItem" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Column="0" Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Line x:Name="GuideUp" Grid.Row="0" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill"
                                          Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1.2 1.6"
                                          HorizontalAlignment="Center"/>
                                    <Line x:Name="GuideDownHead" Grid.Row="1" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill"
                                          Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1.2 1.6"
                                          HorizontalAlignment="Center"/>
                                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Grid.RowSpan="2"
                                          Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1.2 1.6"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Line x:Name="GuideDownBody" Grid.Column="0" Grid.Row="1" X1="0" Y1="0" X2="0" Y2="1"
                                      Stretch="Fill" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1.2 1.6"
                                      HorizontalAlignment="Center"/>
                                <Border x:Name="Row" Grid.Column="1" Grid.Row="0" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="2,4" Margin="0,1">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
                                </Border>
                                <Grid Grid.Column="1" Grid.Row="1">
                                    <Line x:Name="ChildTrunk" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill"
                                          Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1.2 1.6"
                                          HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                    <ItemsPresenter/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding GuideUp}" Value="False">
                                    <Setter TargetName="GuideUp" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GuideDown}" Value="False">
                                    <Setter TargetName="GuideDownHead" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="GuideDownBody" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="ChildTrunk" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#DDE3EA"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#D5DEE8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Actions.Count}" Value="0">
                        <Setter Property="ContextMenu" Value="{x:Null}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SideTab" TargetType="TabItem">
                <Setter Property="Background" Value="#E7EBF0"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,14"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#1D4ED8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Point">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse Width="13" Height="13" Stroke="#2563EB" StrokeThickness="1.4" Fill="#DBEAFE"/>
                            <Path Data="M8,3.5 V12.5 M3.5,8 H12.5" Stroke="#2563EB" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <Canvas Width="16" Height="16">
                            <Canvas.Style>
                                <Style TargetType="Canvas">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Spot">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Canvas.Style>
                            <Ellipse Canvas.Left="1" Canvas.Top="8" Width="4.5" Height="4.5" Fill="#1D4ED8"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="2" Width="4.5" Height="4.5" Fill="#2563EB"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="9" Width="4.5" Height="4.5" Fill="#60A5FA"/>
                        </Canvas>
                        <Path Data="M1,5 L8,2 L15,5 L8,8 Z M1,9 L8,6 L15,9 L8,12 Z" Stroke="#16A34A" StrokeThickness="1.3"
                              StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Terrain">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M8,2 L14,13 H2 Z" Stroke="#15803D" StrokeThickness="1.3" Fill="#DCFCE7"
                              StrokeLineJoin="Round" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Mesh">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M1,12 L4,4 L8,12 L12,4 L15,12" Stroke="#B91C1C" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Break">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M1,4 C4,1 6,7 15,4 M1,8 C4,5 6,11 15,8 M1,12 C4,9 6,15 15,12" Stroke="#A16207"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Contour">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Rectangle Width="12" Height="12" Stroke="#0F766E" StrokeThickness="1.3"
                                   StrokeDashArray="2 1.2" RadiusX="1" RadiusY="1" Fill="Transparent">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Boundary">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <Path Data="M2,12 L8,4 L14,9" Stroke="#EA580C" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Route">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M3,2 H10 L13,5 V14 H3 Z M10,2 V5 H13" Stroke="#7C3AED" StrokeThickness="1.3"
                              StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Profile">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="{Binding EmptyHint}" Foreground="#4B5563" FontSize="11" Margin="0,1,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </HierarchicalDataTemplate>
            <DataTemplate x:Key="ActionButton">
                <Button Content="{Binding Title}" Command="{Binding Command}"
                        Style="{StaticResource CtaSoft}" Margin="0,0,0,8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}" TabStripPlacement="Right"
                Background="Transparent" BorderThickness="0" Padding="0">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource SideTab}"/>
        </TabControl.Resources>

        <TabItem Header="Khảo sát">
            <DockPanel Margin="10,8,6,8" Background="Transparent">
                <TextBlock DockPanel.Dock="Top" Text="{Binding DrawingName}"
                           Foreground="#475569" FontSize="11" Margin="4,0,4,6"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="110"/>
                    </Grid.RowDefinitions>
                    <TreeView x:Name="SurveyTree" Grid.Row="0" ItemsSource="{Binding TreeNodes}"
                              BorderThickness="0" Background="Transparent" Padding="2,0,2,4"
                              VirtualizingPanel.IsVirtualizing="False"
                              local:TreeSelectionBehavior.SelectedItem="{Binding SelectedNode, Mode=OneWayToSource}"
                              ItemContainerStyle="{StaticResource NodeItem}"/>
                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <DockPanel Grid.Row="2" Margin="4,0,4,2">
                        <TextBlock DockPanel.Dock="Top" Text="THUỘC TÍNH" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="2,0,0,6"/>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#94A3B8" StrokeThickness="1"
                                       StrokeDashArray="3 2" Fill="Transparent"/>
                            <StackPanel Margin="12,10" VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding SelectedNode.Name}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="{Binding SelectedNode.Detail}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#334155"/>
                            </StackPanel>
                            <TextBlock Text="Chọn một mục trên cây để xem và hiệu chỉnh" Foreground="#475569"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16,8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Khung in">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                <ItemsControl ItemsSource="{Binding FrameActions}" ItemTemplate="{StaticResource ActionButton}"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="UAV">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                <ItemsControl ItemsSource="{Binding UavActions}" ItemTemplate="{StaticResource ActionButton}"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Bản đồ">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                <ItemsControl ItemsSource="{Binding MapActions}" ItemTemplate="{StaticResource ActionButton}"/>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
