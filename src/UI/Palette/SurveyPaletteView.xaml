<UserControl x:Class="iSurvey.UI.Palette.SurveyPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:iSurvey.UI.Palette"
             Background="#E7EBF0"
             FontFamily="Segoe UI"
             FontSize="13"
             Foreground="#1E293B">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <ContextMenu x:Key="NodeMenu" x:Shared="False"
                         ItemsSource="{Binding PlacementTarget.DataContext.Actions, RelativeSource={RelativeSource Self}}">
                <ContextMenu.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Title}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                    </Style>
                </ContextMenu.ItemContainerStyle>
            </ContextMenu>
            <Style x:Key="NodeItem" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="Row" Grid.Row="0" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="6,5" Margin="0,1">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
                                </Border>
                                <ItemsPresenter Grid.Row="1" Margin="22,0,0,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#DDE3EA"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#D5DEE8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SideTab" TargetType="TabItem">
                <Setter Property="Background" Value="#E7EBF0"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,14"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#1D4ED8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                        <Ellipse Width="14" Height="14" Fill="#3B82F6">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Point">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Point">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Path Data="M1,5 L8,2 L15,5 L8,8 Z M1,9 L8,6 L15,9 L8,12 Z" Stroke="#16A34A" StrokeThickness="1.3"
                              StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Terrain">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M2,12 L8,4 L14,9" Stroke="#EA580C" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Route">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M3,2 H10 L13,5 V14 H3 Z M10,2 V5 H13" Stroke="#7C3AED" StrokeThickness="1.3"
                              StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IconKind}" Value="Profile">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="{Binding EmptyHint}" Foreground="#4B5563" FontSize="11" Margin="0,1,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </HierarchicalDataTemplate>
            <DataTemplate x:Key="ActionButton">
                <Button Content="{Binding Title}" Command="{Binding Command}"
                        Style="{StaticResource CtaSoft}" Margin="0,0,0,8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}" TabStripPlacement="Right"
                Background="Transparent" BorderThickness="0" Padding="0">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource SideTab}"/>
        </TabControl.Resources>

        <TabItem Header="Khảo sát">
            <DockPanel Margin="10,8,6,8" Background="Transparent">
                <TextBlock DockPanel.Dock="Top" Text="{Binding DrawingName}"
                           Foreground="#475569" FontSize="11" Margin="4,0,4,6"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="110"/>
                    </Grid.RowDefinitions>
                    <TreeView x:Name="SurveyTree" Grid.Row="0" ItemsSource="{Binding TreeNodes}"
                              BorderThickness="0" Background="Transparent" Padding="2,0,2,4"
                              VirtualizingPanel.IsVirtualizing="False"
                              local:TreeSelectionBehavior.SelectedItem="{Binding SelectedNode, Mode=OneWayToSource}"
                              ItemContainerStyle="{StaticResource NodeItem}"/>
                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <DockPanel Grid.Row="2" Margin="4,0,4,2">
                        <TextBlock DockPanel.Dock="Top" Text="THUỘC TÍNH" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="2,0,0,6"/>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#94A3B8" StrokeThickness="1"
                                       StrokeDashArray="3 2" Fill="Transparent"/>
                            <StackPanel Margin="12,10" VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding SelectedNode.Name}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="{Binding SelectedNode.Detail}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#334155"/>
                            </StackPanel>
                            <TextBlock Text="Chọn một mục trên cây để xem và hiệu chỉnh" Foreground="#475569"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16,8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Khung in">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                <ItemsControl ItemsSource="{Binding FrameActions}" ItemTemplate="{StaticResource ActionButton}"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="UAV">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                <ItemsControl ItemsSource="{Binding UavActions}" ItemTemplate="{StaticResource ActionButton}"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Bản đồ">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                <ItemsControl ItemsSource="{Binding MapActions}" ItemTemplate="{StaticResource ActionButton}"/>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
