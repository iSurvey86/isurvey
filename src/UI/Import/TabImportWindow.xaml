<Window x:Class="iSurvey.UI.Import.TabImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập MapInfo TAB"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#2B303B" FontFamily="Segoe UI" Foreground="White">
    <Window.Resources>
        <SolidColorBrush x:Key="InputBg" Color="#1E222A"/>
        <SolidColorBrush x:Key="Edge" Color="#6A7588"/>
        <SolidColorBrush x:Key="Accent" Color="#1B8FE0"/>
        <SolidColorBrush x:Key="Muted" Color="#C5CEDB"/>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#3A4454"/>
            <Setter Property="BorderBrush" Value="#8B97A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C5870"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2C3442"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#D5DCE6"/>
                    <Setter Property="Background" Value="#2E3644"/>
                    <Setter Property="BorderBrush" Value="#7E8A9C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#7EC8FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3AA4F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#E7F3FF"/>
                    <Setter Property="Background" Value="#1A5278"/>
                    <Setter Property="BorderBrush" Value="#3D7EAB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1B6CA8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#164E7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                CornerRadius="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Path Width="10" Height="6" HorizontalAlignment="Right" Margin="0,0,12,0"
                                                  VerticalAlignment="Center" Stretch="Fill"
                                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="#D5DCE6"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="#A8B4C6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,36,0" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1E222A" BorderBrush="#6A7588" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="File MapInfo (*.tab)" Foreground="{StaticResource Muted}"/>
        <DockPanel Margin="0,6,0,0">
            <Button x:Name="BrowseButton" Content="Chọn..." Width="88" Margin="8,0,0,0"
                    DockPanel.Dock="Right" Style="{StaticResource DarkButton}"
                    Click="Browse_Click" Padding="8,4"/>
            <TextBox x:Name="PathBox" IsReadOnly="True" Background="{StaticResource InputBg}"
                     Foreground="White" BorderBrush="{StaticResource Edge}" Padding="8,6"/>
        </DockPanel>

        <TextBlock Text="Trường làm nhãn" Margin="0,14,0,0" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="LabelField" Margin="0,6,0,0" IsEnabled="False"
                  HorizontalAlignment="Stretch" MinHeight="34"/>

        <CheckBox x:Name="DrawLabels" Content="Ghi chú nhãn vào điểm trong thửa" IsChecked="True"/>
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Chiều cao chữ" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Width="120"/>
            <TextBox x:Name="TextHeight" Text="2.0" Width="80" HorizontalAlignment="Left"
                     Background="{StaticResource InputBg}" Foreground="White"
                     BorderBrush="{StaticResource Edge}" Padding="8,4"/>
        </DockPanel>

        <CheckBox x:Name="DrawHatch" Content="Giữ nguyên mảng màu tô (Solid, màu MapInfo)" IsChecked="True" Margin="0,14,0,0"/>
        <CheckBox x:Name="DrawOutline" Content="Vẽ đường viền ranh giới (Polyline)" IsChecked="True"/>

        <Border Margin="0,14,0,0" Background="#1E222A" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="6" Padding="10">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#E6EBF2"
                       Text="Chưa chọn file."/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="88" Margin="0,0,8,0" Padding="8,6"
                    Style="{StaticResource DarkButton}" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="Nhập" Width="88" Padding="8,6" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
