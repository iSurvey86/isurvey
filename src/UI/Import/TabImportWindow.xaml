<Window x:Class="iSurvey.UI.Import.TabImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập MapInfo TAB"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="#111827"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="16" Background="White" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="16,12">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            FontSize="12" Style="{StaticResource CtaClose}"
                            Click="Cancel_Click" ToolTip="Đóng"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nhập MapInfo TAB" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Tô màu thửa, layer theo mã sử dụng đất, nhãn trong thửa"
                                   Foreground="#DBEAFE" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,18">
                <TextBlock Text="TỆP NGUỒN" Style="{StaticResource Section}"/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Chọn..." MinWidth="96" Margin="8,0,0,0"
                            Style="{StaticResource CtaSoft}" Click="Browse_Click"/>
                    <TextBox x:Name="PathBox" IsReadOnly="True" Style="{StaticResource Field}"/>
                </DockPanel>

                <TextBlock Text="CÁCH VẼ" Style="{StaticResource Section}" Margin="0,18,0,8"/>
                <TextBlock Text="Trường làm nhãn" Style="{StaticResource Label}"/>
                <ComboBox x:Name="LabelField" IsEnabled="False" MinHeight="36" Padding="8,6"
                          HorizontalAlignment="Stretch" VerticalContentAlignment="Center"/>

                <DockPanel Margin="0,4,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Chiều cao chữ" VerticalAlignment="Center" Foreground="#374151" Margin="0,8,8,0"/>
                        <TextBox x:Name="TextHeight" Text="2.0" Width="72" Style="{StaticResource Field}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="DrawLabels" Content="Ghi chú nhãn vào điểm trong thửa" IsChecked="True"/>
                </DockPanel>
                <CheckBox x:Name="DrawHatch" Content="Giữ nguyên mảng màu tô (Solid, màu MapInfo)" IsChecked="True"/>
                <CheckBox x:Name="DrawOutline" Content="Vẽ đường viền ranh giới (Polyline)" IsChecked="True"/>

                <Border x:Name="StatusCard" Margin="0,16,0,0" Background="#F8FAFC"
                        BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#334155" Text="Chưa chọn file."/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Hủy" MinWidth="96" Margin="0,0,8,0"
                            Style="{StaticResource CtaSoft}" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Content="Nhập" MinWidth="96" IsEnabled="False"
                            Style="{StaticResource CtaPrimary}" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
