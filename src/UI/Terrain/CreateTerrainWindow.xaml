<Window x:Class="iSurvey.UI.Terrain.CreateTerrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Tạo mô hình"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,10">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Cancel_Click" ToolTip="Đóng"/>
                    <TextBlock Text="iSurvey — Tạo mô hình" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="16,14,16,8">
                <TextBlock Text="Tên mô hình" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Padding="8,6" Margin="0,0,0,10"/>
                <TextBlock Text="Lớp lưới" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="LayerBox" Padding="8,6" Text="iSurvey_MoHinh"/>
                <TextBlock Text="Tạo xong hãy thêm điểm, đứt gãy hoặc đồng mức, và một đường bao kín. Lưới chỉ giữ phần trong đường bao."
                           Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Hủy bỏ" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"
                                Style="{StaticResource CtaSoft}"/>
                        <Button Content="Tạo mô hình" MinWidth="120" Click="Create_Click"
                                Style="{StaticResource CtaPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
