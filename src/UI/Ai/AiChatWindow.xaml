<Window x:Class="iSurvey.UI.Ai.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trợ lý AI iSurvey"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" FontFamily="Segoe UI"
        MinWidth="360" MinHeight="420">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#2B303B"/>
        <SolidColorBrush x:Key="InputBg" Color="#1E222A"/>
        <SolidColorBrush x:Key="Edge" Color="#4A5366"/>
        <SolidColorBrush x:Key="Accent" Color="#7C3AED"/>
        <SolidColorBrush x:Key="Muted" Color="#8C96A8"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15" Width="30" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
            CornerRadius="10" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="9,9,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4C1D95" Offset="0"/>
                        <GradientStop Color="#312E81" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,0">
                    <TextBlock Text="Trợ lý AI iSurvey" Foreground="White" FontWeight="Bold"
                               FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                            Click="Close_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Margin="10,8" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="14,0,14,6" FontSize="11"
                       Foreground="{StaticResource Muted}" Text="Admin · Gemini · tool MCP-style"/>

            <Grid Grid.Row="3" Margin="10,0,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" MinHeight="40" MaxHeight="100"
                         TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource InputBg}" Foreground="White" CaretBrush="White"
                         BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="10,8"
                         FontSize="13" KeyDown="InputBox_KeyDown"/>
                <Button x:Name="SendButton" Grid.Column="1" Content="Gửi" Margin="8,0,0,0" Width="72"
                        Height="40" Background="{StaticResource Accent}" Style="{StaticResource ActionButton}"
                        Click="Send_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
