<Window x:Class="iSurvey.UI.DiemDo.ImportPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:iSurvey.UI.DiemDo"
        Title="iSurvey — Nhập điểm đo"
        Width="860" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:SurveyNumberConverter x:Key="SurveyNumber"/>
            <Style x:Key="MarkerButton" TargetType="Button" BasedOn="{StaticResource CtaSoft}">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,10">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Cancel_Click" ToolTip="Đóng" />
                    <TextBlock Text="iSurvey — Nhập điểm đo" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,14,16,8">
                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Mở tệp..." MinWidth="96" Margin="8,0,0,0"
                            Click="Open_Click" Style="{StaticResource CtaSoft}" />
                    <TextBox x:Name="PathBox" IsReadOnly="True" Padding="8,6" VerticalContentAlignment="Center"
                             Text="{Binding FilePath}" />
                </DockPanel>

                <Grid Height="280">
                <local:FaintCellGrid x:Name="GridLines" RowHeight="26" HorizontalAlignment="Left" />
                <DataGrid x:Name="PointGrid" ItemsSource="{Binding Points}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="None" Background="Transparent" BorderBrush="#C4C4C4" BorderThickness="1"
                          AlternatingRowBackground="#F8FAFC" RowHeight="26" HorizontalScrollBarVisibility="Disabled"
                          LayoutUpdated="PointGrid_LayoutUpdated">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6" />
                            <Setter Property="Foreground" Value="#374151" />
                            <Setter Property="BorderBrush" Value="#C4C4C4" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#C4C4C4" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="52" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#6B7280" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tên điểm" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="Tọa độ X" Binding="{Binding X, Converter={StaticResource SurveyNumber}, UpdateSourceTrigger=LostFocus}" Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#60A5FA" />
                                    <Setter Property="Margin" Value="4,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tọa độ Y" Binding="{Binding Y, Converter={StaticResource SurveyNumber}, UpdateSourceTrigger=LostFocus}" Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4ADE80" />
                                    <Setter Property="Margin" Value="4,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cao độ (Z)" Binding="{Binding Z, Converter={StaticResource SurveyNumber}, UpdateSourceTrigger=LostFocus}" Width="*" />
                        <DataGridTextColumn Header="Mã/Ghi chú" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>

                <Border Margin="0,12,0,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Run Text="Tổng điểm đo: " Foreground="#374151" />
                            <Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1D4ED8" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cao chữ:" VerticalAlignment="Center" Foreground="#374151" />
                            <TextBox Width="64" Margin="8,0,16,0" Padding="8,6" VerticalContentAlignment="Center"
                                     Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Kiểu điểm:" VerticalAlignment="Center" Foreground="#374151" />
                            <Button Margin="8,0,0,0" Click="MarkerDot_Click" ToolTip="Dấu chấm">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MarkerButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Marker}" Value="Dot">
                                                <Setter Property="Background" Value="#DBEAFE" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Ellipse Width="8" Height="8" Fill="#334155" />
                            </Button>
                            <Button Click="MarkerNone_Click" ToolTip="Không dấu">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MarkerButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Marker}" Value="None">
                                                <Setter Property="Background" Value="#DBEAFE" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Border Width="12" Height="12" BorderBrush="#64748B" BorderThickness="1.2" Background="Transparent" />
                            </Button>
                            <Button Click="MarkerCross_Click" ToolTip="Tròn gạch chéo">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MarkerButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Marker}" Value="CircleCross">
                                                <Setter Property="Background" Value="#DBEAFE" />
                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#x2297;" FontSize="16" Foreground="#334155" />
                            </Button>
                            <TextBlock Text="Point size:" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#374151" />
                            <TextBox Width="52" Margin="8,0,6,0" Padding="8,6" VerticalContentAlignment="Center"
                                     Text="{Binding PointSizeText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="%" VerticalAlignment="Center" Foreground="#374151" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="+  Thêm điểm" MinWidth="120" Margin="0,0,8,0" Click="Add_Click"
                                Style="{StaticResource CtaSoft}" />
                        <Button Content="Xóa điểm" MinWidth="110" Click="Delete_Click" Style="{StaticResource CtaSoft}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Hủy bỏ" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"
                                Style="{StaticResource CtaSoft}" />
                        <Button Content="↑  Nhập điểm" MinWidth="130" Click="Create_Click" Style="{StaticResource CtaPrimary}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
