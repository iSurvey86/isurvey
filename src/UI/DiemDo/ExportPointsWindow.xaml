<Window x:Class="iSurvey.UI.DiemDo.ExportPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Xuất điểm đo"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,10">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Cancel_Click" ToolTip="Đóng" />
                    <Border DockPanel.Dock="Left" Background="White" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="CAD" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="iSurvey — Xuất điểm đo" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="1. LỌC DỮ LIỆU (TÙY CHỌN)" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox Content="Lọc theo layer" IsChecked="{Binding FilterByLayer}" Foreground="#1F2937" />
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Chọn layer" MinWidth="96" Margin="8,0,0,0"
                                    Click="PickLayer_Click" Style="{StaticResource CtaSoft}" />
                            <TextBox Padding="8,6" VerticalContentAlignment="Center"
                                     Text="{Binding LayerName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding FilterByLayer}" ToolTip="Tên layer" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="2. SỐ LIỆU XUẤT" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Button Content="→  Chọn số liệu trên bản vẽ" HorizontalAlignment="Stretch"
                                Style="{StaticResource CtaSoft}" Click="Pick_Click" />
                        <DockPanel Margin="0,12,0,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontStyle="Italic"
                                       Foreground="#1D4ED8" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Số lẻ thập phân:" VerticalAlignment="Center" Foreground="#374151" />
                                <TextBox Width="50" Margin="8,0,0,0" Padding="8,6" HorizontalContentAlignment="Center"
                                         Text="{Binding DecimalsText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"
                            Style="{StaticResource CtaSoft}" />
                    <Button Content="↑  Xuất tệp" MinWidth="120" Click="Save_Click"
                            Style="{StaticResource CtaSuccess}" IsEnabled="{Binding CanExport}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
