<Window x:Class="iSurvey.UI.DiemDo.ExportPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Xuất điểm đo"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,10">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                            Background="Transparent" BorderThickness="0" FontSize="12" Width="28" Height="28"
                            Click="Cancel_Click" ToolTip="Đóng" />
                    <TextBlock Text="iSurvey — Xuất điểm đo" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,14,16,8">
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="LỌC DỮ LIỆU" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox Content="Lọc theo layer" IsChecked="{Binding FilterByLayer}" Foreground="#1F2937" />
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Chọn layer" MinWidth="96" Margin="8,0,0,0" Padding="10,6"
                                    Click="PickLayer_Click" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" />
                            <TextBox Padding="8,6" VerticalContentAlignment="Center"
                                     Text="{Binding LayerName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding FilterByLayer}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="LẤY ĐIỂM" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Button x:Name="WindowButton" Content="Xác định vùng (chữ nhật)" Height="36" Margin="0,0,0,8"
                                Click="Window_Click" />
                        <Button x:Name="PolyButton" Content="Chọn vùng (polyline kín)" Height="36" Margin="0,0,0,8"
                                Click="Poly_Click" />
                        <Button x:Name="DirectButton" Content="Chọn điểm trực tiếp" Height="36" Click="Direct_Click" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="GHI TỆP" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Số lẻ sau dấu thập phân:" VerticalAlignment="Center" Foreground="#374151" />
                            <TextBox Width="56" Margin="8,0,0,0" Padding="8,6"
                                     Text="{Binding DecimalsText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Margin="0,10,0,0" Foreground="#1F2937"
                                  Content="Đảo cột X/Y"
                                  IsChecked="{Binding SwapAxes}" />
                        <TextBlock Margin="0,10,0,0" Foreground="#6B7280" TextWrapping="Wrap" Text="{Binding Hint}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" MinWidth="88" Padding="12,8" Margin="0,0,8,0" Click="Cancel_Click"
                            Background="White" BorderBrush="#D1D5DB" BorderThickness="1" />
                    <Button Content="⤒  Ghi tệp xuất (CSV/TXT)" MinWidth="180" Padding="12,8" Click="Save_Click"
                            Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
