<Window x:Class="iSurvey.UI.KmlExport.KmlExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Xuất KML / KMZ"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        Foreground="#1F2937"
        FontFamily="Segoe UI"
        FontSize="13"
        Loaded="OnLoaded">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10,8,10,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel>
            <!-- fieldset: chỉ combo tỉnh -->
            <GroupBox Header="Tỉnh/thành" Margin="0,0,0,6">
                <ComboBox x:Name="ProvinceCombo"
                          DisplayMemberPath="ProvinceName"
                          SelectionChanged="ProvinceCombo_SelectionChanged"/>
            </GroupBox>
            <TextBlock x:Name="MeridianLabel"
                       Text="Kinh tuyến trục: —"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       Margin="2,0,0,8"/>

            <TextBlock Text="Múi chiếu" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="Zone3Radio" Content="Múi 3°" IsChecked="True"
                             GroupName="ExportZone" Checked="Zone_Changed" Margin="0,2,16,2"/>
                <RadioButton x:Name="Zone6Radio" Content="Múi 6°"
                             GroupName="ExportZone" Checked="Zone_Changed" Margin="0,2"/>
            </StackPanel>

            <!-- 2 cột: Phạm vi | Định dạng -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Phạm vi">
                    <StackPanel>
                        <RadioButton x:Name="AllModelRadio" Content="Toàn bộ bản vẽ" GroupName="Scope"/>
                        <RadioButton x:Name="SelectionRadio" Content="Chọn đối tượng" GroupName="Scope" IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Định dạng">
                    <StackPanel>
                        <RadioButton x:Name="KmzRadio" Content="KMZ" GroupName="Format" IsChecked="True"/>
                        <RadioButton x:Name="KmlRadio" Content="KML" GroupName="Format"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <CheckBox x:Name="GroupByLayerCheck" Content="Gộp theo lớp (Folder trên GE)" IsChecked="True"/>
            <CheckBox x:Name="UseZCheck" Content="Dùng cao độ Z (absolute)"/>
            <CheckBox x:Name="OpenAfterCheck" Content="Mở file sau khi xuất" IsChecked="True" Margin="0,4,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Xuất..." Click="Export_Click" Margin="0,0,8,0"
                        Background="{StaticResource Accent}" Foreground="White"
                        BorderBrush="{StaticResource Accent}" FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="Hủy" Click="Cancel_Click"
                        Background="White" Foreground="{StaticResource TextPrimary}"
                        BorderBrush="{StaticResource Border}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
