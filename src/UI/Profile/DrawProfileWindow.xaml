<Window x:Class="iSurvey.UI.Profile.DrawProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Vẽ mặt cắt dọc"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,10">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Cancel_Click" ToolTip="Đóng"/>
                    <TextBlock Text="iSurvey — Vẽ mặt cắt dọc" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="16,14,16,8">
                <TextBlock Text="Tuyến" Foreground="#374151" Margin="0,0,0,4"/>
                <ComboBox x:Name="RouteBox" Padding="8,6" Margin="0,0,0,10" SelectionChanged="RouteBox_SelectionChanged"/>
                <TextBlock Text="Tên mặt cắt" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Padding="8,6" Margin="0,0,0,10"/>
                <TextBlock Text="Tỷ lệ đứng ; ngang" Foreground="#374151" Margin="0,0,0,4"/>
                <ComboBox x:Name="ScaleBox" Padding="8,6" Margin="0,0,0,10" SelectionChanged="ScaleBox_SelectionChanged"/>
                <TextBlock Text="Mức so sánh (m)" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="DatumBox" Padding="8,6" Margin="0,0,0,6"/>
                <TextBlock x:Name="HintText" Foreground="#64748B" TextWrapping="Wrap" FontSize="12"
                           Text="Hàng dưới cùng là Khoảng cách cộng dồn — RAIMCD chọn góc đó để rải khung. Sau khi bấm Vẽ, chỉ điểm chèn trên Model."/>
            </StackPanel>
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Hủy bỏ" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"
                                Style="{StaticResource CtaSoft}"/>
                        <Button Content="Vẽ" MinWidth="100" Click="Ok_Click"
                                Style="{StaticResource CtaPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
