<Window x:Class="iSurvey.UI.Profile.DrawProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Vẽ Mặt Cắt Dọc Tự Nhiên"
        Width="1240" SizeToContent="Height"
        MinWidth="1160" MinHeight="420" MaxHeight="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Sec" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1D4ED8"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="4,3"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="Foreground" Value="#1F2937"/>
            </Style>
            <Style x:Key="TinyBtn" TargetType="Button" BasedOn="{StaticResource CtaSoft}">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="FooterBtn" TargetType="Button" BasedOn="{StaticResource CtaSoft}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="FooterPrimary" TargetType="Button" BasedOn="{StaticResource CtaPrimary}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="BandGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
                <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="RowHeight" Value="34"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="EnableRowVirtualization" Value="False"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White" CornerRadius="10" Margin="10" BorderBrush="#BFDBFE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="10,10,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="12,8">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Cancel_Click" ToolTip="Đóng"/>
                    <TextBlock Text="iSurvey — Vẽ Mặt Cắt Dọc Tự Nhiên" Foreground="White"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Body 2 cột -->
            <Grid Grid.Row="1" Margin="12,10,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG SỐ NỘI SUY &amp; VẼ" Style="{StaticResource Sec}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên tuyến:" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                  ItemsSource="{Binding RouteNames}"
                                  SelectedIndex="{Binding SelectedRouteIndex, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Khoảng cách lấy Z (m):" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                 Text="{Binding SampleStepText, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  Content="Vẽ nhiều tuyến"
                                  IsChecked="{Binding DrawMultipleRoutes}"/>
                    </Grid>

                    <TextBlock Text="TÙY CHỌN HÌNH HỌC" Style="{StaticResource Sec}" Margin="0,8,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Tỷ lệ đứng (V)" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding VerticalScaleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="1" Text="Tỷ lệ ngang (H)" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding HorizontalScaleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="2" Text="Cao độ Min (Datum)" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding DatumText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="3" Text="Cao chữ TD" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding ProfileTextHeightText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <StackPanel Margin="0,8,0,0">
                        <CheckBox Content="Điền lý trình" IsChecked="{Binding FillChainage}"/>
                        <CheckBox Content="Điền mức so sánh TD" IsChecked="{Binding FillDatumLabels}"/>
                        <CheckBox Content="Chèn thước tỷ lệ trái" IsChecked="{Binding InsertLeftScaleBar}"/>
                        <CheckBox Content="Chèn thước tỷ lệ phải" IsChecked="{Binding InsertRightScaleBar}"/>
                        <CheckBox Content="Vẽ đầu bảng TD" IsChecked="{Binding DrawBandHeader}"/>
                        <CheckBox Content="Hiển thị dạng lưới" IsChecked="{Binding ShowGrid}"/>
                        <CheckBox Content="Chữ thập" IsChecked="{Binding DrawCrossMark}"/>
                    </StackPanel>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Rộng thước tỷ lệ" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ScaleBarWidthText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="1" Text="Cách hàng" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding RowGapText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="2" Text="Cách đầu bảng" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding HeaderClearanceText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="{Binding Hint}" Foreground="#64748B" TextWrapping="Wrap"
                               FontSize="11" Margin="0,10,0,0" MaxWidth="290"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="#E5E7EB" Margin="0,2"/>

                <!-- Cột phải -->
                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DANH SÁCH MẪU BẢNG" Style="{StaticResource Sec}"
                               VerticalAlignment="Center" Margin="0,0,0,6"/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
                        <Button Content="Nhập" Style="{StaticResource TinyBtn}" Click="Import_Click" Margin="0,0,4,0"/>
                        <Button Content="Xuất" Style="{StaticResource TinyBtn}" Click="Export_Click" Margin="0,0,8,0"/>
                        <TextBlock Text="|" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="+" Style="{StaticResource TinyBtn}" Click="AddRow_Click" Margin="0,0,4,0" ToolTip="Thêm hàng"/>
                        <Button Content="−" Style="{StaticResource TinyBtn}" Click="RemoveRow_Click" Margin="0,0,10,0" ToolTip="Xóa hàng"/>
                        <TextBlock Text="Rộng đầu bảng:" Style="{StaticResource Lbl}"/>
                        <TextBox Width="70" Text="{Binding LabelWidthText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                        <TextBlock Text="|" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Chọn mẫu bảng:" Style="{StaticResource Lbl}" Margin="0,0,4,0"/>
                        <ComboBox Width="140"
                                  ItemsSource="{Binding TemplateNames}"
                                  Text="{Binding TemplateName, Mode=TwoWay}"
                                  IsEditable="True"/>
                    </DockPanel>

                    <DataGrid x:Name="BandGrid" Grid.Row="2" Style="{StaticResource BandGrid}"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhãn" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                MinWidth="120"
                                                ToolTipService.ToolTip="Chữ hiện bên trái đầu bảng"/>
                            <DataGridTextColumn Header="Layer" Binding="{Binding Layer, UpdateSourceTrigger=PropertyChanged}" Width="1.1*"
                                                MinWidth="100"/>
                            <DataGridTemplateColumn Header="Kiểu chữ" Width="100" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.TextStyleNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Text="{Binding TextStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEditable="True" Padding="2,0" FontSize="11" Height="20"
                                                  VerticalAlignment="Center" Margin="1,0"
                                                  ToolTip="Mặc định iSurvey_TD (Arial Unicode Windows)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Màu" Width="56" MinWidth="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ColorBrush}" BorderBrush="#94A3B8" BorderThickness="1"
                                                CornerRadius="2" Cursor="Hand" Height="20" Margin="2,0"
                                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                ToolTip="Nhắp để chọn màu AutoCAD"
                                                PreviewMouseLeftButtonDown="ColorCell_Click">
                                            <TextBlock Text="{Binding ColorText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontSize="10"
                                                       Foreground="#111827"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Cao chữ" Binding="{Binding TextHeight, UpdateSourceTrigger=PropertyChanged}" Width="70" MinWidth="56"/>
                            <DataGridTextColumn Header="Cao hàng" Binding="{Binding RowHeight, UpdateSourceTrigger=PropertyChanged}" Width="70" MinWidth="56"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,10,10" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Vẽ trắc dọc tự nhiên" Style="{StaticResource FooterPrimary}"
                                Margin="0,0,6,0" Click="Draw_Click"/>
                        <Button Content="Cập nhật số liệu từ trắc dọc" Style="{StaticResource FooterBtn}"
                                Margin="0,0,6,0" Click="UpdateFromProfile_Click"/>
                        <Button Content="Cập nhật thuộc tính TD" Style="{StaticResource FooterBtn}"
                                Margin="0,0,6,0" Click="UpdateProps_Click"/>
                        <Button Content="Cập nhật số liệu từ TN" Style="{StaticResource FooterBtn}"
                                Click="UpdateFromTin_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Hủy bỏ" Style="{StaticResource FooterBtn}" MinWidth="88"
                                Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Lưu thiết lập" Style="{StaticResource FooterPrimary}" MinWidth="120"
                                Click="SaveSettings_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
