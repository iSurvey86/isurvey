<Window x:Class="iSurvey.UI.Profile.DrawProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Vẽ Mặt Cắt Dọc Tự Nhiên"
        SizeToContent="WidthAndHeight"
        MinWidth="900" MinHeight="420" MaxHeight="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/iSurvey;component/src/UI/CtaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Sec" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1D4ED8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="4,3"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,3,0,3"/>
                <Setter Property="Foreground" Value="#1F2937"/>
            </Style>
            <Style x:Key="TinyBtn" TargetType="Button" BasedOn="{StaticResource CtaSoft}">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="FooterBtn" TargetType="Button" BasedOn="{StaticResource CtaSoft}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="FooterPrimary" TargetType="Button" BasedOn="{StaticResource CtaPrimary}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <!-- CTA cột trái ~300px → ô ~145px: chữ nhỏ, cho xuống dòng. -->
            <Style x:Key="LeftCta" TargetType="Button" BasedOn="{StaticResource CtaSoft}">
                <Setter Property="Padding" Value="6,6"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LeftCtaPrimary" TargetType="Button" BasedOn="{StaticResource CtaPrimary}">
                <Setter Property="Padding" Value="6,6"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="BandHeader" TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="4,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="BandCell" TargetType="DataGridCell">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="4,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BandCellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="BandCellEdit" TargetType="TextBox">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="2,0"/>
            </Style>
            <Style x:Key="BandGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
                <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="RowHeight" Value="34"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="EnableRowVirtualization" Value="False"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource BandHeader}"/>
                <Setter Property="CellStyle" Value="{StaticResource BandCell}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White" CornerRadius="10" Margin="10" BorderBrush="#BFDBFE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="10,10,0,0" MouseLeftButtonDown="Header_Drag">
                <DockPanel Margin="14,9">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource CtaClose}" Click="Cancel_Click" ToolTip="Đóng"/>
                    <TextBlock Text="iSurvey — Vẽ Mặt Cắt Dọc Tự Nhiên" Foreground="White"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Body 2 cột -->
            <Grid Grid.Row="1" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DỮ LIỆU &amp; HÌNH HỌC" Style="{StaticResource Sec}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tên tuyến:" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RouteNames}"
                                  SelectedIndex="{Binding SelectedRouteIndex, Mode=TwoWay}"/>
                    </Grid>

                    <!-- 2×2: tỷ lệ V|H; cao độ | cách đầu bảng — bỏ ô thước (cao chữ=12, rộng vạch tự theo chữ). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tỷ lệ V" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VerticalScaleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Tỷ lệ H" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding HorizontalScaleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cao độ Min" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatumText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Cách đầu bảng" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding HeaderClearanceText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <DockPanel Margin="0,3,0,3" LastChildFill="True">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding FillChainage}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="Điền lý trình" Style="{StaticResource Lbl}" Margin="0"/>
                        </DockPanel>
                        <DockPanel Margin="0,3,0,3" LastChildFill="True">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DrawCrossMark}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="Hiển thị chữ thập" Style="{StaticResource Lbl}" Margin="0"/>
                        </DockPanel>
                        <DockPanel Margin="0,3,0,3" LastChildFill="True"
                                   ToolTip="Vẽ lại toàn bộ tuyến đã có cọc; dàn trang xuống dưới cách 50">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DrawMultipleRoutes}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="Vẽ nhiều tuyến" Style="{StaticResource Lbl}" Margin="0"/>
                        </DockPanel>

                        <!-- CTA 2×2 dưới «Vẽ nhiều tuyến» — vừa cột trái ~300px. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource LeftCtaPrimary}"
                                    Click="Draw_Click" ToolTip="Vẽ trắc dọc tự nhiên">
                                <TextBlock Text="Vẽ trắc dọc tự nhiên" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource LeftCta}"
                                    Click="UpdateFromProfile_Click" ToolTip="Cập nhật số liệu từ TD">
                                <TextBlock Text="Cập nhật SL từ TD" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource LeftCta}"
                                    Click="UpdateProps_Click" ToolTip="Cập nhật thuộc tính TD">
                                <TextBlock Text="Cập nhật thuộc tính từ TD" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource LeftCta}"
                                    Click="UpdateFromTin_Click" ToolTip="Cập nhật số liệu từ TN">
                                <TextBlock Text="Cập nhật số liệu từ TN" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="#E5E7EB" Margin="0,2"/>

                <!-- Cột phải: Layer giữ trong model/mẫu (không hiện UI). -->
                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hàng tiêu đề + thao tác mẫu -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Nhập" Style="{StaticResource TinyBtn}" Click="Import_Click" Margin="0,0,4,0"/>
                            <Button Content="Xuất" Style="{StaticResource TinyBtn}" Click="Export_Click" Margin="0,0,8,0"/>
                            <TextBlock Text="|" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="+" Style="{StaticResource TinyBtn}" Click="AddRow_Click" Margin="0,0,4,0" ToolTip="Thêm hàng"/>
                            <Button Content="−" Style="{StaticResource TinyBtn}" Click="RemoveRow_Click" ToolTip="Xóa hàng"/>
                        </StackPanel>
                        <TextBlock Text="KHAI BÁO MẪU BẢNG" Style="{StaticResource Sec}" Margin="0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Hàng thông số: rộng đầu bảng | mẫu -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rộng đầu bảng" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Column="1" Text="{Binding LabelWidthText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="Mẫu bảng" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Column="4" MinWidth="140"
                                  ItemsSource="{Binding TemplateNames}"
                                  Text="{Binding TemplateName, Mode=TwoWay}"
                                  IsEditable="True"/>
                    </Grid>

                    <DataGrid x:Name="BandGrid" Grid.Row="2" Style="{StaticResource BandGrid}"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="40" MinWidth="36"
                                                IsReadOnly="True"
                                                EditingElementStyle="{StaticResource BandCellEdit}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BandCell}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BandCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                Width="320" MinWidth="240"
                                                ElementStyle="{StaticResource BandCellText}"
                                                EditingElementStyle="{StaticResource BandCellEdit}"
                                                ToolTipService.ToolTip="Chỉ đổi nhãn in ra bản vẽ — không đổi loại số liệu (cao_do, ly_trinh…)"/>
                            <DataGridTextColumn Header="Cao chữ" Binding="{Binding TextHeight, UpdateSourceTrigger=PropertyChanged}"
                                                Width="72" MinWidth="64"
                                                EditingElementStyle="{StaticResource BandCellEdit}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BandCell}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BandCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cao hàng" Binding="{Binding RowHeight, UpdateSourceTrigger=PropertyChanged}"
                                                Width="72" MinWidth="64"
                                                EditingElementStyle="{StaticResource BandCellEdit}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BandCell}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BandCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- Footer: chỉ đóng / lưu — CTA vẽ/cập nhật đã ở cột trái. -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,10,10" Padding="12,9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Hủy bỏ" Style="{StaticResource FooterBtn}" MinWidth="88"
                                Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Lưu thiết lập" Style="{StaticResource FooterPrimary}" MinWidth="120"
                                Click="SaveSettings_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
