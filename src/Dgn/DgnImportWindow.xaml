<Window x:Class="iSurvey.Dgn.DgnImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Nhập DGN ➔ CAD"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B303B"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded"
        Activated="OnActivated">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#2B303B"/>
        <SolidColorBrush x:Key="InputBg" Color="#1E222A"/>
        <SolidColorBrush x:Key="Edge" Color="#454D5E"/>
        <SolidColorBrush x:Key="Muted" Color="#8C96A8"/>
        <SolidColorBrush x:Key="Accent" Color="#1B6CA8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12,8,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Margin="0,8,0,0" CornerRadius="8"
                                    BorderBrush="{StaticResource Edge}" BorderThickness="1"/>
                            <TextBlock Text="{TemplateBinding Header}" Margin="12,0,0,0" Padding="6,0"
                                       Background="{StaticResource Panel}" FontWeight="SemiBold"/>
                            <ContentPresenter Grid.Row="1" Margin="12,10,12,12"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A4150"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>

        <Style x:Key="Success" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,18">
        <!-- 1. Tệp & chế độ nhập -->
        <GroupBox x:Name="FileGroup" Header="1. Tệp DGN &amp; chế độ nhập">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}"
                             ToolTip="Đường dẫn file .dgn (MicroStation V7 hoặc V8)"/>
                    <Button Grid.Column="2" Content="Chọn file..." Style="{StaticResource Small}" Click="Browse_Click"/>
                </Grid>
                <RadioButton x:Name="ModeInsertRadio" GroupName="Mode" IsChecked="True" Margin="0,10,0,0"
                             Content="Chèn vào Model Space hiện hành" Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeBatchRadio" GroupName="Mode" Checked="Mode_Changed"
                             Content="Batch nhiều file .dgn"/>
                <StackPanel x:Name="BatchPanel" Visibility="Collapsed" Margin="22,2,0,0">
                    <RadioButton x:Name="BatchCombineRadio" GroupName="BatchKind" Checked="BatchKind_Changed"
                                 Content="Ghép tất cả vào MỘT bản vẽ mới (chưa lưu, các mảnh liền nhau theo tọa độ)"/>
                    <RadioButton x:Name="BatchSeparateRadio" GroupName="BatchKind" IsChecked="True" Checked="BatchKind_Changed"
                                 Content="Không ghép: mỗi file một .DWG riêng cùng thư mục (DC1.dgn ➔ DC1.dwg)"/>
                    <StackPanel x:Name="ExistPanel" Margin="22,2,0,0">
                        <TextBlock Style="{StaticResource Hint}" Text="Nếu file .dwg cùng tên đã tồn tại:" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ExistNumberRadio" GroupName="Exist" IsChecked="True"
                                         Content="Đánh số mới (_1, _2…)" Margin="0,0,16,0"/>
                            <RadioButton x:Name="ExistSkipRadio" GroupName="Exist" Content="Bỏ qua" Margin="0,0,16,0"/>
                            <RadioButton x:Name="ExistOverwriteRadio" GroupName="Exist" Content="Ghi đè"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Dùng engine DGN có sẵn của AutoCAD/Civil 3D cho cả V7 và V8 — không cần MicroStation."/>
            </StackPanel>
        </GroupBox>

        <!-- 2. Đơn vị & layer -->
        <GroupBox Header="2. Đơn vị &amp; đặt tên layer">
            <StackPanel>
                <TextBlock Text="Đơn vị chuyển đổi" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                <Border Background="#1E222A" BorderBrush="#454D5E" BorderThickness="1" CornerRadius="6" Padding="2"
                        Margin="0,0,0,10">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="UnitsMasterRadio" GroupName="Units" Style="{StaticResource Seg}"
                                     Content="Master Units (mặc định)" IsChecked="True"/>
                        <RadioButton x:Name="UnitsSubRadio" GroupName="Units" Style="{StaticResource Seg}"
                                     Content="Sub Units"/>
                    </UniformGrid>
                </Border>

                <TextBlock Text="Layer sau khi nhập" Style="{StaticResource Hint}" Margin="0,0,0,2"/>
                <RadioButton x:Name="LayerKeepRadio" GroupName="LayerMode" IsChecked="True"
                             Content="Giữ nguyên Level gốc"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LayerPrefixRadio" GroupName="LayerMode" VerticalAlignment="Center"
                                 Content="Thêm tiền tố:"/>
                    <TextBox x:Name="PrefixBox" Style="{StaticResource FieldBox}" Width="110" Height="28"
                             Margin="10,0,0,0" Text="DGN_"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LayerMapRadio" GroupName="LayerMode" VerticalAlignment="Center"
                                 Content="Ánh xạ Level ➔ Layer địa chính (JSON)"/>
                    <Button Content="Mở bảng ánh xạ..." Style="{StaticResource Small}" Height="28" MinWidth="120"
                            Margin="12,0,0,0" Click="OpenMap_Click"/>
                </StackPanel>
                <TextBlock x:Name="MapInfoText" Style="{StaticResource Hint}" Margin="22,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 3. Tự động dọn -->
        <GroupBox Header="3. Tự động làm sạch sau khi nhập">
            <StackPanel>
                <CheckBox x:Name="FixFontCheck" IsChecked="True"
                          Content="Chuyển mã TCVN3 ➔ Unicode (font Arial) cho chữ"/>
                <CheckBox x:Name="ExplodeCheck"
                          Content="Chuyển DGN Cell (block) thành đối tượng CAD thường (Explode)"/>
                <CheckBox x:Name="PurgeCheck" IsChecked="True"
                          Content="Dọn linetype / layer / block rác do DGN sinh ra"/>
                <CheckBox x:Name="ZoomCheck" IsChecked="True"
                          Content="Zoom vào vùng vừa nhập"/>
            </StackPanel>
        </GroupBox>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Hủy" Style="{StaticResource Ghost}" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Grid.Column="2" Content="✓ Thực hiện Nhập DGN"
                    Style="{StaticResource Success}" IsDefault="True" Click="Confirm_Click"/>
        </Grid>
    </StackPanel>
</Window>
