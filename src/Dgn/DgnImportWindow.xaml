<Window x:Class="iSurvey.Dgn.DgnImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Nhập DGN"
        Width="980" Height="640" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F3F5F7" FontFamily="Segoe UI" FontSize="13"
        Foreground="#1C2430" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1C2430"/>
            <Setter Property="BorderBrush" Value="#C9D2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7F9FB"/>
                                <Setter Property="BorderBrush" Value="#9AA8B5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9AA3AD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#1C2430"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#1C2430"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel x:Name="FilePanel" Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock x:Name="TotalLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="#5C6B7A" Text="Tổng số: 0 tệp"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="Thêm tệp..." Style="{StaticResource ToolBtn}" Click="Add_Click"/>
                    <Button x:Name="UpBtn" Content="Lên trên" Style="{StaticResource ToolBtn}" Click="Up_Click"/>
                    <Button x:Name="DownBtn" Content="Xuống dưới" Style="{StaticResource ToolBtn}" Click="Down_Click"/>
                    <Button x:Name="RemoveBtn" Content="Xóa" Style="{StaticResource ToolBtn}" Margin="0" Click="Remove_Click"/>
                </StackPanel>
            </DockPanel>

            <Border Background="White" BorderBrush="#D5DCE3" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="SheetHost" IsHitTestVisible="False" Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E1E6EC" VerticalGridLinesBrush="#E1E6EC"
                              BorderThickness="0" Background="Transparent" RowBackground="White"
                              AlternatingRowBackground="White" RowHeight="32"
                              SelectionMode="Single" CanUserAddRows="False" CanUserResizeRows="False"
                              SelectionChanged="FileGrid_SelectionChanged" SizeChanged="FileGrid_SizeChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F7F9FB"/>
                            <Setter Property="Foreground" Value="#3D4A57"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="#E1E6EC"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="BorderBrush" Value="#E1E6EC"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E7F2EA"/>
                                    <Setter Property="Foreground" Value="#1C2430"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="56"/>
                        <DataGridTextColumn Header="Tên tệp" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="Đường dẫn" Binding="{Binding Folder}" Width="*"/>
                        <DataGridTextColumn Header="Kích thước" Binding="{Binding SizeText}" Width="110"/>
                    </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelBtn" Content="Hủy" MinWidth="110" Height="38" Click="Cancel_Click"
                    Background="White" Foreground="#1C2430" BorderBrush="#C9D2DC" BorderThickness="1"
                    Cursor="Hand" FontSize="14">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="OkBtn" Content="Nhập DGN" MinWidth="160" Height="42" Margin="10,0,0,0"
                    Click="Confirm_Click" Background="#16803C" Foreground="White" BorderThickness="0"
                    Cursor="Hand" FontSize="15" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#146C32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#B7C4B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D5DCE3" BorderThickness="1" CornerRadius="4" Padding="14,10,14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Cài đặt nhập DGN" FontWeight="SemiBold"
                           Foreground="#1C2430" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Chế độ xuất" Foreground="#5C6B7A" Margin="0,0,0,8"/>
                        <RadioButton x:Name="BatchRadio" Content="Ghép thành một file .dwg" IsChecked="True"/>
                        <RadioButton x:Name="SeparateRadio" Content="Rời từng file .dwg"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Đặt tên layer sau khi nhập" Foreground="#5C6B7A" Margin="0,0,0,8"/>
                        <RadioButton x:Name="KeepRadio" Content="Giữ nguyên Level gốc" IsChecked="True"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PrefixRadio" Content="Thêm tiền tố:" VerticalAlignment="Center" Margin="0"/>
                            <TextBox x:Name="PrefixBox" Text="iSurvey_" Width="130" Height="28" Margin="8,0,0,0"
                                     VerticalAlignment="Center" Padding="6,2" BorderBrush="#C9D2DC" BorderThickness="1"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tự động chuyển đổi chữ" Foreground="#5C6B7A" Margin="0,0,0,8"/>
                        <CheckBox x:Name="FontCheck" Content="Chuyển TCVN3 sang Unicode" IsChecked="True"/>
                        <CheckBox x:Name="ExplodeCheck" Content="Phá khối DGN Cell (Explode)" IsChecked="False"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
