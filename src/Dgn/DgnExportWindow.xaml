<Window x:Class="iSurvey.Dgn.DgnExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSurvey — Xuất CAD ➔ DGN"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B303B"
        Foreground="#E2E6ED"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#2B303B"/>
        <SolidColorBrush x:Key="Edge" Color="#454D5E"/>
        <SolidColorBrush x:Key="Muted" Color="#8C96A8"/>
        <SolidColorBrush x:Key="Text" Color="#E2E6ED"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- GroupBox kiểu fieldset/legend: viền bo, tiêu đề đè lên viền -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Margin="0,8,0,0" CornerRadius="8"
                                    BorderBrush="{StaticResource Edge}" BorderThickness="1"/>
                            <TextBlock Text="{TemplateBinding Header}" Margin="12,0,0,0" Padding="6,0"
                                       Background="{StaticResource Panel}" FontWeight="SemiBold"
                                       HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Row="1" Margin="14,8,14,12"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A4150"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Success" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,18">
        <!-- Tiêu đề -->
        <TextBlock Text="📤 XUẤT CAD SANG MICROSTATION DGN (C2D)" FontSize="15" FontWeight="Bold"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16"
                   Text="Chuyển đổi bản vẽ hiện hành sang định dạng .dgn chuẩn VN-2000"/>

        <!-- 1. Phạm vi -->
        <GroupBox Header="1. Phạm vi đối tượng xuất">
            <StackPanel>
                <RadioButton x:Name="RbAll" GroupName="Scope" IsChecked="True"
                             Content="Xuất toàn bộ bản vẽ (Model Space hiện tại)"/>
                <RadioButton x:Name="RbSelected" GroupName="Scope"
                             Content="Chỉ xuất các đối tượng đang chọn trên màn hình"/>
                <TextBlock x:Name="SelectedInfo" Style="{StaticResource Hint}" Margin="22,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. Phiên bản -->
        <GroupBox Header="2. Phiên bản MicroStation đích">
            <StackPanel>
                <RadioButton x:Name="RbV8" GroupName="Ver" IsChecked="True" Checked="Version_Changed">
                    <StackPanel>
                        <TextBlock Text="MicroStation V8 (.dgn) — Khuyên dùng"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Không giới hạn không gian thiết kế"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RbV7" GroupName="Ver" Checked="Version_Changed">
                    <StackPanel>
                        <TextBlock Text="MicroStation SE / V7 (.dgn) — Định dạng cũ"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Tích hợp sẵn Seed Global Origin VN-2000"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </GroupBox>

        <!-- 3. Tùy chọn -->
        <GroupBox Header="3. Tùy chọn bổ sung">
            <StackPanel>
                <CheckBox x:Name="ChkPurge" IsChecked="True"
                          Content="Tự động dọn rác bản vẽ (Purge) trước khi xuất"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,4"
                           Text="Thực hiện trên bản sao tạm — bản vẽ đang mở không bị thay đổi."/>
                <CheckBox x:Name="ChkOverwrite" IsChecked="True"
                          Content="Ghi đè tự động nếu file DGN đích đã tồn tại"/>
            </StackPanel>
        </GroupBox>

        <!-- Chân hộp thoại -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SeedInfo" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Margin="0,0,10,0" Text="Tự động dùng Seed chuẩn VN-2000"/>
            <Button x:Name="BtnCancel" Grid.Column="1" Content="Hủy" Width="85" Style="{StaticResource Ghost}"
                    IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="BtnExport" Grid.Column="2" Content="✓ Xuất file DGN" Width="125" Margin="8,0,0,0"
                    Style="{StaticResource Success}" IsDefault="True" Click="BtnExport_Click"/>
        </Grid>
    </StackPanel>
</Window>
